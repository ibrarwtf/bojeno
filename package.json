{
  "name": "bojeno",
  "version": "0.0.1",
  "description": "Local-first job-search automation desktop app",
  "main": "./out/main/index.js",
  "author": "ibrarwtf",
  "homepage": "https://github.com/ibrarwtf/bojeno",
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "npm run typecheck && npm run lint && npm run test",
    "devcheck": "node scripts/devcheck.cjs",
    "dev:clean": "node scripts/dev-restart.cjs",
    "start": "electron-vite preview",
    "dev": "npm run dev:clean && electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check",
    "commit-msg": "node scripts/check-commit-msg.cjs $1"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.0"
  }
}
